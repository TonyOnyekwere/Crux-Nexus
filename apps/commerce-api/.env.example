# Application
APP_NAME=CruxNexus Commerce API
DEBUG=false
ENVIRONMENT=production

# Database - REQUIRED - MUST be provided by deployment environment
# Railway provides DATABASE_URL automatically
# NEVER hardcode production connection strings
DATABASE_URL=

# Redis - REQUIRED - MUST be provided by deployment environment  
# Railway provides REDIS_URL automatically
# NEVER hardcode production connection strings
REDIS_URL=

# Security - REQUIRED - MUST be provided by deployment environment
# NEVER hardcode production secrets
SECRET_KEY=

# JWT - REQUIRED - MUST be provided by deployment environment
# NEVER hardcode production secrets
JWT_SECRET_KEY=

# CORS
CORS_ORIGINS=["https://*.cruxnexus.com","http://localhost:3000"]

# Provider defaults
PLATFORM_DEFAULT_PAYMENT_PROVIDER=paystack
PLATFORM_DEFAULT_LOGISTICS_PROVIDER=fallback
PLATFORM_DEFAULT_NOTIFICATION_PROVIDER=sendgrid

# Railway
PORT=8000
RAILWAY_ENVIRONMENT=production